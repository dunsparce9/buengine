{
  "id": "abode",
  "background": "images/scenes/new-abode.jpg",
  "backgroundColor": "#000000",
  "grid": {
    "cols": 32,
    "rows": 16
  },
  "elements": [
    "hud"
  ],
  "sequences": {
    "ladder_choice": [
      {
        "choice": {
          "prompt": "What do you do?",
          "options": [
            {
              "text": "Try to open it",
              "actions": [
                {
                  "say": "You push the hatch. It creaks open…",
                  "speaker": "Ominous voice"
                },
                {
                  "set": {
                    "clicked_ladder": true
                  }
                },
                {
                  "say": "Nothing interesting happens.",
                  "speaker": "Ominous voice"
                },
                {
                  "exit": true
                }
              ]
            },
            {
              "text": "Wait, you're not the narrator?",
              "actions": [
                {
                  "say": "*coughs* Ahem sorry",
                  "speaker": "Narrator"
                },
                {
                  "run": "ladder_choice"
                }
              ]
            },
            {
              "text": "Walk away",
              "actions": [
                {
                  "say": "You turn around. There's nowhere else to go.",
                  "speaker": "Narrator"
                },
                {
                  "exit": true
                }
              ]
            }
          ]
        }
      }
    ],
    "beerspam": [
      {
        "loop": 4,
        "do": [
          {
            "playsound": {
              "id": "beer",
              "path": "sounds/objects/clink.opus",
              "volume": 0.1,
              "loop": false,
              "blocking": false
            }
          },
          {
            "wait": 100
          }
        ]
      }
    ],
    "pick_up_seal": [
      {
        "set": {
          "seal_picked_up": 1
        }
      },
      {
        "item": {
          "id": "seal",
          "qty": 1
        }
      },
      {
        "animate": {
          "target": "object",
          "id": "seal",
          "to": {
            "rotation": 45,
            "opacity": 0,
            "scale": 0
          },
          "seconds": 0.6,
          "easing": "ease-in",
          "blocking": true
        }
      },
      {
        "hide": {
          "id": "seal"
        }
      }
    ]
  },
  "objects": [
    {
      "id": "ladder",
      "label": "Mysterious ladder",
      "x": 23,
      "y": 6,
      "w": 9,
      "h": 10,
      "options": [
        {
          "text": "Go down",
          "icon": "⬇️",
          "actions": [
            {
              "if": "items.seal.qty > 0",
              "then": [
                {
                  "speaker": "Narrator",
                  "say": "The seal is too heavy, you can't even walk to the ladder. Put down the seal first."
                },
                {
                  "exit": true
                }
              ],
              "else": []
            },
            {
              "if": "abode.ladder.clicks >= 2",
              "then": [
                {
                  "say": "Yep, ladder still there. What do?",
                  "speaker": "Ominous voice"
                }
              ]
            },
            {
              "if": "abode.ladder.clicks == 1",
              "then": [
                {
                  "say": "You find a huge mysterious ladder that probably leads somewhere.",
                  "speaker": "Ominous voice"
                }
              ]
            },
            {
              "run": "ladder_choice"
            }
          ]
        }
      ]
    },
    {
      "id": "spaghetti",
      "label": "Stale spaghetti",
      "x": 13,
      "y": 11,
      "w": 3,
      "h": 2,
      "options": [
        {
          "text": "Examine",
          "icon": "👁️",
          "actions": [
            {
              "say": "A disgusting(LY GOOD) plate of spaghetti and meatballs.",
              "speaker": "Narrator"
            },
            {
              "set": {
                "found_spaghetti": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "beer",
      "label": "Mug of ber",
      "x": 6,
      "y": 6,
      "w": 2,
      "h": 2,
      "options": [
        {
          "text": "Examine",
          "icon": "👁️",
          "actions": [
            {
              "playsound": {
                "id": "beer",
                "path": "sounds/objects/clink.opus",
                "volume": 0.1,
                "loop": false,
                "blocking": false
              }
            },
            {
              "if": "abode.beer.clicks >= 5",
              "then": [
                {
                  "say": "Beer.",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "if": "abode.beer.clicks == 4",
              "then": [
                {
                  "say": "Genuinely unbelieveable. It just KEEPS being beer!",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "if": "abode.beer.clicks == 3",
              "then": [
                {
                  "say": "Yep, beer!",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "if": "abode.beer.clicks == 2",
              "then": [
                {
                  "say": "It's still beer.",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "if": "abode.beer.clicks == 1",
              "then": [
                {
                  "say": "It's beer.",
                  "speaker": "Narrator"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "seal",
      "label": "Seal!",
      "texture": "images/seal.png",
      "x": 20,
      "y": 9,
      "w": 3,
      "h": 3,
      "onHover": [
        {
          "if": {
            "left": "{embiggened}",
            "operator": "==",
            "right": "true"
          },
          "then": [
            {
              "animate": {
                "id": "this",
                "to": {
                  "scale": 6
                },
                "seconds": 0.15,
                "blocking": true
              }
            },
            {
              "animate": {
                "id": "this",
                "to": {
                  "scale": 5
                },
                "seconds": 0.15,
                "blocking": true
              }
            }
          ],
          "else": [
            {
              "animate": {
                "id": "this",
                "to": {
                  "scale": 1.08
                },
                "seconds": 0.15,
                "blocking": true
              }
            },
            {
              "animate": {
                "id": "this",
                "to": {
                  "scale": 1
                },
                "seconds": 0.15,
                "blocking": true
              }
            }
          ]
        }
      ],
      "options": [
        {
          "text": "Observe",
          "icon": "👁️",
          "actions": [
            {
              "playsound": {
                "id": "büe",
                "path": "sounds/objects/büe.opus",
                "volume": 0.1,
                "loop": false,
                "blocking": false
              }
            },
            {
              "say": "Büe...",
              "speaker": "Seal",
              "accent": "#9edfff"
            },
            {
              "if": "abode.ladder.clicks >= 1",
              "then": [
                {
                  "say": "The seal noticed your humble attempt at going down the ominous ladder.",
                  "speaker": "Narrator"
                },
                {
                  "say": "It lets out a curious and suggestive büe. You start feeling like you should check other parts of the room before going down.",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "if": "abode.ladder.clicks == 0",
              "then": [
                {
                  "say": "The cute seal pup bües at you, respectfully.",
                  "speaker": "Narrator"
                }
              ]
            },
            {
              "choice": {
                "options": [
                  {
                    "text": "Büe back at ya!",
                    "actions": []
                  },
                  {
                    "text": "Pick up the seal.",
                    "actions": [
                      {
                        "if": "seal_picked_up == 0",
                        "then": [
                          {
                            "say": "what",
                            "speaker": "Narrator"
                          }
                        ],
                        "else": []
                      },
                      {
                        "run": "pick_up_seal"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "text": "Pick up",
          "icon": "🤏",
          "actions": [
            {
              "run": "pick_up_seal"
            }
          ]
        },
        {
          "text": "Seal Configuration Wizard...",
          "icon": "⚙️",
          "actions": [
            {
              "choice": {
                "prompt": "Welcome to the Seal Configuration Wizard.",
                "options": [
                  {
                    "text": "Embiggen",
                    "actions": [
                      {
                        "if": {
                          "left": "{embiggened}",
                          "operator": "==",
                          "right": "true"
                        },
                        "then": [
                          {
                            "say": "The seal cannot be embiggened further.",
                            "speaker": ""
                          }
                        ],
                        "else": [
                          {
                            "animate": {
                              "target": "object",
                              "id": "this",
                              "to": {
                                "scale": 5
                              },
                              "seconds": 2,
                              "easing": "ease-in-out"
                            }
                          },
                          {
                            "set": {
                              "embiggened": {
                                "expr": "true",
                                "operation": "set"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "text": "Fly",
                    "actions": [
                      {
                        "animate": {
                          "target": "object",
                          "id": "this",
                          "to": {
                            "rotation": 30,
                            "x": -4,
                            "y": -4
                          },
                          "seconds": 1,
                          "easing": "ease-in-out",
                          "blocking": true
                        }
                      },
                      {
                        "say": "The seal flew away.",
                        "speaker": ""
                      },
                      {
                        "set": {
                          "seal_flew": {
                            "expr": "true",
                            "operation": "set"
                          }
                        }
                      },
                      {
                        "hide": {
                          "id": "bow"
                        }
                      },
                      {
                        "show": {
                          "id": "bow_shootable"
                        }
                      }
                    ]
                  },
                  {
                    "text": "Send to Shadow Realm",
                    "actions": [
                      {
                        "hide": {
                          "id": "this"
                        }
                      }
                    ]
                  },
                  {
                    "text": "Cancel",
                    "actions": []
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sloplogo",
      "x": 30,
      "y": 15,
      "w": 2,
      "h": 1,
      "options": [
        {
          "text": "Interact",
          "icon": "",
          "actions": [
            {
              "say": "You have clicked the slop logo.",
              "speaker": "Google(TM) Gemini(R)",
              "accent": "#ffffff"
            }
          ]
        }
      ],
      "label": "Gemini™ Slop Logo"
    },
    {
      "id": "fourbeer",
      "x": 6,
      "y": 9,
      "w": 2,
      "h": 5,
      "options": [
        {
          "text": "Examine",
          "icon": "👁️👁️👁️👁️",
          "actions": [
            {
              "fork": {
                "run": "beerspam"
              }
            },
            {
              "speaker": "Drunk as shit narrator",
              "say": "Four beers are better than one beers.",
              "typewriterSpeed": 1
            }
          ]
        }
      ],
      "label": "Four mugs of ber"
    },
    {
      "id": "object",
      "x": 14,
      "y": 9,
      "w": 2,
      "h": 1,
      "options": [],
      "label": "Plate of whatever the fuck",
      "cursor": "default"
    },
    {
      "id": "bow_shootable",
      "x": 9,
      "y": 1,
      "w": 2,
      "h": 3,
      "options": [
        {
          "text": "Shoot",
          "icon": "",
          "actions": [
            {
              "if": {
                "left": "{arrow_shot}",
                "operator": "==",
                "right": "true"
              },
              "then": [],
              "else": [
                {
                  "set": {
                    "arrow_shot": {
                      "expr": "true",
                      "operation": "set"
                    }
                  }
                },
                {
                  "say": "YOU SHOT THE SEAL\nOH GOD",
                  "speaker": "Narrator????"
                },
                {
                  "say": "ITS BLEEDING",
                  "speaker": "Narrator????"
                },
                {
                  "say": "WHAT THE FUCK",
                  "speaker": "Narrator????"
                }
              ]
            },
            {
              "say": "BÜE",
              "speaker": "SEAL (DEAD)",
              "accent": "#ff5252"
            }
          ]
        }
      ],
      "label": "Bow",
      "visible": false
    },
    {
      "id": "bow",
      "x": 9,
      "y": 1,
      "w": 2,
      "h": 3,
      "options": [
        {
          "text": "Inspect",
          "icon": "",
          "actions": [
            {
              "say": "Yep, it's a bow. Wonder when i'll get to use it.",
              "speaker": ""
            }
          ]
        }
      ],
      "label": "Bow"
    }
  ],
  "onEnter": [
    {
      "animate": {
        "target": "scene",
        "from": {
          "opacity": 0
        },
        "to": {
          "opacity": 1
        },
        "easing": "ease",
        "seconds": 1,
        "blocking": false
      }
    },
    {
      "say": "You awaken in a humble abode. There's beer (ber!), and spaghetti with meatballs.",
      "speaker": "Narrator"
    }
  ]
}
